# Copy to .env.local and fill in from your Supabase project settings → API.
# Anything prefixed EXPO_PUBLIC_ is embedded in the app bundle, so only ever put
# the anon/publishable key here — never the service role key.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
